cabal-version:      2.4
name:               claw
version:            0.1.0.0

synopsis: Extensions for using Haskell as an interactive shell.

author:             LatencyIndex
maintainer:         LatencyIndex

extra-source-files:
    LICENSE
    README.md

common shared-properties
    default-language: Haskell2010
    ghc-options:
        -Wall
        -Wcompat
        -Wunused-packages

library
    import: shared-properties
    exposed-modules:
        Claw.Audio
        Claw.Control
        Claw.FilePath
        Claw.FileSystem
        Claw.Image
        Claw.Time
        Claw.Internal.List
        Claw.Internal.Numeric
        Claw.Internal.PrettyPrint
        Claw.Video
    other-modules:
    default-extensions:
        OverloadedRecordDot
        OverloadedStrings
        DuplicateRecordFields
    build-depends:
        base,
        directory,
        filepath,
        process,
        time,
        unix,
    hs-source-dirs: src

executable claw
    import: shared-properties
    main-is: claw.hs
    build-depends:
        base,
        directory,
        filepath,
        process,
    hs-source-dirs: exe
